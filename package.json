{
  "name": "claude-flow-designer",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @clauflow/core -w @clauflow/canvas -w @clauflow/web -w clauflow-vscode",
    "test": "vitest run",
    "dev:web": "npm run dev -w @clauflow/web",
    "dev:vscode": "npm run watch -w clauflow-vscode",
    "package:vscode": "npm run package -w clauflow-vscode",
    "lint": "eslint packages",
    "gate": "npm run -s typecheck && npm run -s test",
    "typecheck": "tsc -b packages/core packages/canvas packages/vscode",
    "fixtures:regen": "npm run -s build -w @clauflow/core && node packages/core/scripts/regen-fixtures.mjs",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.0.0"
  }
}
