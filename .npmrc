# npm network resilience. Without these, `npm ci` on CI runners can hang
# indefinitely on a slow/stalled registry fetch (surfacing as npm's "Exit handler
# never called!" crash after a long timeout). These make npm time out and retry
# a stuck fetch instead of blocking the whole install.
fetch-timeout=120000
fetch-retries=4
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fund=false
audit=false
