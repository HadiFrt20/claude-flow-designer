# Use the public npm registry. This repo is developed inside Databricks, whose
# environment defaults npm to an internal proxy (npm-proxy.dev.databricks.com)
# that public GitHub Actions runners cannot reach — every tarball GET timed out.
# The committed lockfile's resolved URLs are pinned to this same public host.
registry=https://registry.npmjs.org/

# npm network resilience: time out and retry a stalled fetch instead of hanging.
fetch-timeout=120000
fetch-retries=4
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fund=false
audit=false
