[
  {
    "content": "{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}
",
    "path": ".claude/settings.json",
  },
  {
    "content": "---
description: Review the staged/committed diff and report issues by severity.
allowed-tools: Bash(git *)
argument-hint: "[base-branch]"
---

## Context
- !\`git diff $1...HEAD\`

Review the diff above against $1. List findings grouped by severity (blocker/major/minor), each with file:line and a concrete fix.
",
    "path": ".claude/skills/pr-review/SKILL.md",
  },
  {
    "content": "{
  "version": 1,
  "meta": {
    "name": "PR Review",
    "slug": "pr-review",
    "description": "Review the current diff for issues"
  },
  "settings": {
    "model": "sonnet",
    "permissions": {
      "allow": [
        "Bash(git diff *)",
        "Bash(git log *)"
      ],
      "deny": [],
      "ask": []
    }
  },
  "nodes": [
    {
      "id": "cmd",
      "kind": "trigger.slashCommand",
      "label": "pr-review",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "name": "pr-review",
        "description": "Review the staged/committed diff and report issues by severity.",
        "args": [
          {
            "name": "base",
            "placeholder": "$1"
          }
        ],
        "argumentHint": "[base-branch]"
      }
    },
    {
      "id": "diff",
      "kind": "step.shell",
      "label": "diff",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "command": "git diff $1...HEAD",
        "embedOutput": true
      }
    },
    {
      "id": "ask",
      "kind": "step.prompt",
      "label": "review",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "body": "Review the diff above against $1. List findings grouped by severity (blocker/major/minor), each with file:line and a concrete fix."
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "cmd",
      "target": "diff"
    },
    {
      "id": "e2",
      "source": "diff",
      "target": "ask"
    }
  ]
}
",
    "path": "flow.clauflow.json",
  },
]
`;

exports[`template gallery > security-gate generates a stable file set (snapshot) 1`] = `
[
  {
    "content": "#!/bin/bash
# Generated by Claude Flow Designer — hook for PreToolUse. Do not edit by hand.
set -euo pipefail
command -v jq >/dev/null || { echo "jq required" >&2; exit 1; }

input=$(cat)

cmd=$(jq -r '.tool_input.command // ""' <<<"$input")
if printf '%s' "$cmd" | grep -Eq 'rm[[:space:]]+-rf|:\\(\\)\\{'; then
  blocked=1
else
  blocked=0
fi
if [ "$blocked" -eq 0 ]; then exit 0; fi
jq -n --arg reason 'Destructive command blocked by the security gate.' '{ permissionDecisionReason: $reason, hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $reason } }'
exit 0
",
    "executable": true,
    "path": ".claude/hooks/pretooluse-1.sh",
  },
  {
    "content": "{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [],
            "command": "\${CLAUDE_PROJECT_DIR}/.claude/hooks/pretooluse-1.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf *)"
    ]
  }
}
",
    "path": ".claude/settings.json",
  },
  {
    "content": "{
  "version": 1,
  "meta": {
    "name": "Security Gate",
    "slug": "security-gate",
    "description": "Deny destructive shell commands via a PreToolUse hook"
  },
  "settings": {
    "permissions": {
      "allow": [],
      "deny": [
        "Bash(rm -rf *)"
      ],
      "ask": []
    }
  },
  "nodes": [
    {
      "id": "trg",
      "kind": "trigger.hookEvent",
      "label": "pre-bash",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "event": "PreToolUse",
        "matcher": "Bash",
        "scope": "project"
      }
    },
    {
      "id": "guard",
      "kind": "hook.command",
      "label": "guard",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "command": "bash",
        "scriptBody": "cmd=$(jq -r '.tool_input.command // \\"\\"' <<<\\"$input\\")\\nif printf '%s' \\"$cmd\\" | grep -Eq 'rm[[:space:]]+-rf|:\\\\(\\\\)\\\\{'; then\\n  blocked=1\\nelse\\n  blocked=0\\nfi\\nif [ \\"$blocked\\" -eq 0 ]; then exit 0; fi"
      }
    },
    {
      "id": "deny",
      "kind": "output.decision",
      "label": "deny",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "mode": "deny",
        "reason": "Destructive command blocked by the security gate.",
        "blockStyle": "json"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "trg",
      "target": "guard"
    },
    {
      "id": "e2",
      "source": "guard",
      "target": "deny"
    }
  ]
}
",
    "path": "flow.clauflow.json",
  },
]
`;

exports[`template gallery > session-context-loader generates a stable file set (snapshot) 1`] = `
[
  {
    "content": "#!/bin/bash
# Generated by Claude Flow Designer — hook for SessionStart. Do not edit by hand.
set -euo pipefail
command -v jq >/dev/null || { echo "jq required" >&2; exit 1; }

# stdin carries the hook payload; read it even if this handler ignores fields.
# shellcheck disable=SC2034
input=$(cat)

ctx=$(git -C "$CLAUDE_PROJECT_DIR" status --short 2>/dev/null || echo "no git")
printf '%s' "$ctx" > /tmp/clauflow-ctx.txt
jq -n --arg actx 'Repo status loaded at session start.' '{ additionalContext: $actx }'
exit 0
",
    "executable": true,
    "path": ".claude/hooks/sessionstart-1.sh",
  },
  {
    "content": "{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [],
            "command": "\${CLAUDE_PROJECT_DIR}/.claude/hooks/sessionstart-1.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}
",
    "path": ".claude/settings.json",
  },
  {
    "content": "{
  "version": 1,
  "meta": {
    "name": "Session Context Loader",
    "slug": "session-context-loader",
    "description": "Inject repo status into context at session start"
  },
  "settings": {},
  "nodes": [
    {
      "id": "trg",
      "kind": "trigger.sessionStart",
      "label": "on start",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "matcher": "startup"
      }
    },
    {
      "id": "load",
      "kind": "hook.command",
      "label": "load context",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "command": "bash",
        "scriptBody": "ctx=$(git -C \\"$CLAUDE_PROJECT_DIR\\" status --short 2>/dev/null || echo \\"no git\\")\\nprintf '%s' \\"$ctx\\" > /tmp/clauflow-ctx.txt"
      }
    },
    {
      "id": "note",
      "kind": "output.decision",
      "label": "add context",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "mode": "allow",
        "additionalContext": "Repo status loaded at session start."
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "trg",
      "target": "load"
    },
    {
      "id": "e2",
      "source": "load",
      "target": "note"
    }
  ]
}
",
    "path": "flow.clauflow.json",
  },
]
`;

