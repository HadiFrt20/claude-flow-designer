exports[`template gallery > test-fix generates a stable file set (snapshot) 1`] = `
[
  {
    "content": "// Generated by claude-flow-designer. Do not edit by hand.
export const meta = { name: "test-fix", description: "Run tests and fix failures until green" }

let round = 0
let lastProgress = null
let fixLoop
while (round < 2) {
  const check = await agent(\`Run the test suite and report whether it passed.\`, { schema: {
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "progress": {
      "type": "number"
    }
  },
  "type": "object"
}, label: \`check\` })
  fixLoop = check
  if (check.passed) break
  if (round > 0 && check.progress !== undefined && check.progress === lastProgress) break
  lastProgress = check.progress
  await agent(\`Fix the failures reported: \${JSON.stringify(check)}.\`, { label: \`fix\` })
  round++
}

return fixLoop
",
    "path": ".claude/workflows/test-fix.js",
  },
  {
    "content": "{
  "version": 1,
  "meta": {
    "name": "Test Fix",
    "slug": "test-fix",
    "description": "Run tests and fix failures until green"
  },
  "settings": {},
  "nodes": [
    {
      "id": "meta",
      "kind": "workflow.meta",
      "label": "Test Fix",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "name": "test-fix",
        "description": "Run tests and fix failures until green"
      }
    },
    {
      "id": "loop",
      "kind": "loopUntilCheck",
      "label": "Fix loop",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "checkPrompt": "Run the test suite and report whether it passed.",
        "checkSchema": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "progress": {
              "type": "number"
            }
          }
        },
        "passField": "passed",
        "fixPrompt": "Fix the failures reported: {{check}}.",
        "maxRounds": 2
      }
    },
    {
      "id": "ret",
      "kind": "output.return",
      "label": "return",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "source": "loop",
        "transform": "none"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "meta",
      "target": "loop"
    },
    {
      "id": "e2",
      "source": "loop",
      "target": "ret"
    }
  ]
}
",
    "path": "test-fix.clauflow.json",
  },
]
`;
