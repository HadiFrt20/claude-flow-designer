exports[`template gallery > test-fix-loop generates a stable file set (snapshot) 1`] = `
[
  {
    "content": "{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Edit"
    ]
  }
}
",
    "path": ".claude/settings.json",
  },
  {
    "content": "{
  "version": 1,
  "meta": {
    "name": "Test-Fix Loop",
    "slug": "test-fix-loop",
    "description": "Headless: run tests, fix failures, repeat",
    "ackedWarnings": [
      "CF502"
    ]
  },
  "settings": {
    "model": "sonnet",
    "permissions": {
      "allow": [
        "Bash(npm test *)",
        "Bash(npm run *)",
        "Edit"
      ],
      "deny": [],
      "ask": []
    },
    "headless": {
      "enabled": true,
      "outputFormat": "stream-json",
      "maxTurns": 40,
      "verbose": true
    }
  },
  "nodes": [
    {
      "id": "run",
      "kind": "trigger.headless",
      "label": "runner",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "promptTemplate": "Run the test suite. For each failing test, diagnose and fix the code, then re-run until green. Do not weaken assertions."
      }
    },
    {
      "id": "step",
      "kind": "step.prompt",
      "label": "loop",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "body": "Iterate: run tests → read the first failure → fix → re-run."
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "run",
      "target": "step"
    }
  ]
}
",
    "path": "flow.clauflow.json",
  },
  {
    "content": "#!/bin/bash
# Generated by Claude Flow Designer — headless runner.
set -euo pipefail

claude -p 'Run the test suite. For each failing test, diagnose and fix the code, then re-run until green. Do not weaken assertions.' --model 'sonnet' --output-format stream-json --max-turns 40 --verbose
",
    "executable": true,
    "path": "run.sh",
  },
]
`;
