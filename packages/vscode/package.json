{
  "name": "clauflow-vscode",
  "displayName": "Claude Flow Designer",
  "description": "Visual workflow designer for Claude Code: design on a canvas, export skills, subagents, hooks, and settings.",
  "version": "0.1.0",
  "publisher": "your-publisher",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Visualization"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [{
      "viewType": "clauflow.editor",
      "displayName": "Claude Flow Designer",
      "selector": [{ "filenamePattern": "*.clauflow.json" }]
    }],
    "commands": [
      { "command": "claudeFlow.new", "title": "Claude Flow: New Workflow" },
      { "command": "claudeFlow.import", "title": "Claude Flow: Import from .claude/" },
      { "command": "claudeFlow.export", "title": "Claude Flow: Export to .claude/" },
      { "command": "claudeFlow.run", "title": "Claude Flow: Run Workflow (terminal)" }
    ],
    "views": { "explorer": [{ "id": "claudeFlow.assets", "name": "Claude Workflows" }] }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "package": "vsce package"
  },
  "devDependencies": { "@types/vscode": "^1.90.0", "esbuild": "^0.23.0", "@vscode/vsce": "^3.0.0" },
  "dependencies": { "@clauflow/core": "*" }
}
