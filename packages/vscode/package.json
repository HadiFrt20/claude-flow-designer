{
  "name": "clauflow-vscode",
  "displayName": "Claude Flow Designer",
  "description": "Visual designer for Claude Code dynamic workflows: build on a canvas, export a ready-to-run .claude/workflows/<name>.js orchestration script.",
  "version": "0.1.0",
  "publisher": "clauflow",
  "repository": { "type": "git", "url": "https://github.com/HadiFrt20/claude-flow-designer.git" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Visualization"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing a workflow works in Restricted Mode, but exporting to .claude/workflows/ and running the workflow in a terminal require a trusted workspace."
    }
  },
  "contributes": {
    "customEditors": [{
      "viewType": "clauflow.editor",
      "displayName": "Claude Flow Designer",
      "selector": [{ "filenamePattern": "*.clauflow.json" }]
    }],
    "commands": [
      { "command": "claudeFlow.new", "title": "Claude Flow: New Workflow" },
      { "command": "claudeFlow.import", "title": "Claude Flow: Open / Import Workflow…" },
      { "command": "claudeFlow.export", "title": "Claude Flow: Export to .claude/workflows/" },
      { "command": "claudeFlow.run", "title": "Claude Flow: Run Workflow (terminal)" },
      { "command": "claudeFlow.refreshAssets", "title": "Claude Flow: Refresh Workflows", "icon": "$(refresh)" }
    ],
    "views": { "explorer": [{ "id": "claudeFlow.assets", "name": "Claude Workflows" }] },
    "menus": {
      "view/title": [
        { "command": "claudeFlow.refreshAssets", "when": "view == claudeFlow.assets", "group": "navigation" }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "@vscode/vsce": "^3.0.0"
  },
  "dependencies": {
    "@clauflow/core": "*",
    "@clauflow/canvas": "*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
