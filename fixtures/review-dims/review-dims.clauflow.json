{
  "version": 1,
  "meta": {
    "name": "Review Dims",
    "slug": "review-dims",
    "description": "Review each dimension concurrently, then merge"
  },
  "settings": {},
  "nodes": [
    {
      "id": "meta",
      "kind": "workflow.meta",
      "label": "Review Dims",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "name": "review-dims",
        "description": "Review each dimension concurrently, then merge"
      }
    },
    {
      "id": "list",
      "kind": "agent",
      "label": "List dimensions",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "prompt": "List the review dimensions.",
        "schema": {
          "type": "object",
          "required": [
            "dims"
          ],
          "properties": {
            "dims": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "id": "review",
      "kind": "parallel",
      "label": "Review each",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "source": "list",
        "sourceField": "dims",
        "itemVar": "d",
        "itemPrompt": "Review dimension {{d}} of {{list}}.",
        "itemLabel": "review:{{d}}",
        "extraOpts": {
          "phase": "'Review'"
        }
      }
    },
    {
      "id": "ret",
      "kind": "output.return",
      "label": "return",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "source": "review",
        "transform": "filterBoolean"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "meta",
      "target": "list"
    },
    {
      "id": "e2",
      "source": "list",
      "target": "review"
    },
    {
      "id": "e3",
      "source": "review",
      "target": "ret"
    }
  ]
}
